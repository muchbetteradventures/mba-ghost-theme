<section class="subscribe-form">
    <h3 class="subscribe-form-title">{{#if title}}{{title}}{{else}}Get the Much Better newsletter{{/if}}</h3>
    <p class="subscribe-form-description">{{#if description}}{{description}}{{else}}Get weekly inspiration, positive stories, exclusive community invites and other weird and wonderful stuff.{{/if}}</p>

    {{#if members}}
    {{!-- Opt-in: Ghost Members (Portal auto-binds this form) --}}
    <form data-members-form="subscribe">
        <div class="form-group">
            <input class="subscribe-email" data-members-email placeholder="{{#if placeholder}}{{placeholder}}{{else}}youremail@example.com{{/if}}" autocomplete="false" />
            <button class="button primary" type="submit">
                <span class="button-content">{{#if button}}{{button}}{{else}}Subscribe{{/if}}</span>
                <span class="button-loader">{{> "icons/loader"}}</span>
            </button>
        </div>
        <div class="message-success">
            <strong>Great!</strong> Check your inbox and click the link to confirm your subscription.
        </div>
        <div class="message-error">
            Please enter a valid email address!
        </div>
    </form>
    {{else}}
    {{!-- Default: external Mailchimp POST (matches existing subscribe-form.hbs), opens in new tab --}}
    <form
        action="{{#if action}}{{action}}{{else}}https://muchbetteradventures.us2.list-manage.com/subscribe/post?u=8ef039ed02db26fcd1c723274&id=a887ab1707{{/if}}"
        target="_blank" method="post">
        <div class="form-group">
            <input class="subscribe-email" name="EMAIL" placeholder="{{#if placeholder}}{{placeholder}}{{else}}youremail@example.com{{/if}}" />
            <input type="hidden" id="gdpr_13" name="gdpr[13]" value="Y" class="av-checkbox gdpr">
            <button class="button primary" type="submit">
                <span class="button-content">{{#if button}}{{button}}{{else}}Subscribe{{/if}}</span>
                <span class="button-loader">{{> "icons/loader"}}</span>
            </button>
        </div>
        <div class="message-success">
            <strong>Great!</strong> Check your inbox and click the link to confirm your subscription.
        </div>
        <div class="message-error">
            Please enter a valid email address!
        </div>
    </form>
    {{/if}}
</section>
